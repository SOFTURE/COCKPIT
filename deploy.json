{
  "$schema": "https://unpkg.com/@softure-ai/deploy/schema/deploy.schema.json",
  "publicPaths": [
    "/api/health",
    "/unsubscribe",
    "/api/mailing/unsubscribe",
    "/icon",
    "/apple-icon",
    "/api/mcp",
    "/api/oauth/token",
    "/api/oauth/register",
    "/.well-known/oauth-authorization-server",
    "/.well-known/oauth-protected-resource"
  ],
  "releases": { "keep": 5 },
  "database": { "access": "compose-exec" },
  "verify": {
    "headers": { "strict-transport-security": "max-age=", "x-powered-by": null },
    "routes": [
      { "path": "/api/health", "contains": ["\"status\":\"ok\""] },
      { "path": "/unsubscribe", "excludes": ["Application error"] }
    ]
  }
}
