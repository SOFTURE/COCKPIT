# Copy to .env.local for `next dev`. Nothing here is a secret: real values live in the deployment.
# The database: a PGlite directory for local runs (default), postgres://… in production.
DATABASE_URL=pglite://.data/dev
APP_ORIGIN=http://localhost:3000
# Local stacks have no edge that names the client address; count them under one shared key.
# Never set this in production.
ALLOW_UNIDENTIFIED_CLIENTS=true
