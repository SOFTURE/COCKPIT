# Copy to .env.local for `next dev`. Nothing here is a secret: real values live in the deployment.
# The database: a PGlite directory for local runs (default), postgres://… in production.
DATABASE_URL=pglite://.data/dev
APP_ORIGIN=http://localhost:3000
# Local stacks have no edge that names the client address; count them under one shared key.
# Never set this in production.
ALLOW_UNIDENTIFIED_CLIENTS=true
# Production only: which header names the client behind the edge (cloudflare, forwarded-for or header:<name>), trusted
# only on requests that carry EDGE_PROOF_SECRET, which the app's router sets (docker/prod/docker-compose.yml).
# CLIENT_IP_SOURCE=cloudflare
# EDGE_PROOF_SECRET=
# The forge COCKPIT reads watched repositories from. A fine-grained token limited to the watched repositories with
# Metadata, Contents, Pull requests and Actions read, and Issues read and write (NFR-5). Never commit a real one.
FORGE_TOKEN=
# FORGE_API_URL=https://api.github.com
# How often every watched project is read, in minutes: 15 to 60 (default 30). `npm run worker` runs the scan.
# SCAN_INTERVAL_MINUTES=30
# Run the job worker inside `next dev` / `next start` (needed with a PGlite directory). Production runs `npm run worker`.
JOBS_IN_APP_PROCESS=true
